Date: {DAY / MONTH / YEAR} // This will be autogenerated based on unicode

[To do] // if there is a line with ":To do" at the front:
[BOARD][0] To do
[BOARD][1] Doing
[BOARD][2] Done

[PROFILE] <Work> // if there is a work profile
[BOARD][1] Bugs
[BOARD][3] Fixing

[PROFILE] <Work + Personal>  // if there is a personal and work profile
- [BOARD] Fixing // remove board fixing

if [PROFILE] <Personal - Work>  // if there is a personal but no work profile
- [BOARD] Fixing // remove board fixing

if [PROFILE] has <Personal, Computer>  // if there is a personal or a computer profile
- [BOARD] Fixing // remove board fixing

[+Computer] // if there is something with tag "Computer"
#ff0000 // change color to red
@coding // add a context
+!5days // adds 5 days to the due date

[!5 days] // if there is something due in 5 days
+urgent // add the "urgent" tag
+ * // adds 1 more priority level

[!-5 days] // if there is something that should be done 5 days prior
+overdue
rgb(255, 0, 0)
+ 3* // adds 3 more priority levels
